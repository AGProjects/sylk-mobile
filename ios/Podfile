if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  #use_frameworks! :linkage => linkage.to_sym
  use_frameworks! :linkage => :static
end


target 'sylk' do
  # Pods for sylk
  # use_frameworks!
  #
  # Flags change depending on the env values.

  # flags = get_default_flags()
  config = use_native_modules!
  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  # react-native-compressor and react-native-video are Swift pods that depend on
  # DoubleConversion / glog / RCT-Folly (C++ pods with no module map). Built as
  # static libraries, Swift can't import them without a module map. Re-declare
  # each with the SAME podspec source use_react_native! uses (so it merges
  # rather than conflicting on "multiple sources") and add :modular_headers.
  pod 'DoubleConversion', :podspec => '../node_modules/react-native/third-party-podspecs/DoubleConversion.podspec', :modular_headers => true
  pod 'glog', :podspec => '../node_modules/react-native/third-party-podspecs/glog.podspec', :modular_headers => true
  pod 'RCT-Folly', :podspec => '../node_modules/react-native/third-party-podspecs/RCT-Folly.podspec', :modular_headers => true
  # react-native-permissions handlers are now selected via setup_permissions()
  # near the top of this Podfile (v5); the RNPermissions pod itself is autolinked.
  # RN 0.76: the core React pods (React, React-Core, RCTRequired, RCTTypeSafety,
  # FBLazyVector, FBReactNativeSpec, Yoga, React-cxxreact, React-jsi,
  # React-callinvoker, ReactCommon/turbomodule, and every React-RCT* library)
  # are now declared by use_react_native! above. Listing them by hand duplicates
  # and conflicts — RCTRequired even moved from Libraries/RCTRequired to
  # Libraries/Required, which is the "multiple dependencies with different
  # sources for RCTRequired" error. react-native-version-number is autolinked,
  # so it's gone too. Only pods RN can't provide are kept below.
  # react-native-dtmf keeps its podspec in ios/ instead of the package
  # root, so RN autolinking reports ios: null and never links it — the
  # JS module resolves to null and dialpad key tones are silent on iOS.
  # Link it manually here.
  pod 'RNDtmf', :path => '../node_modules/react-native-dtmf/ios'

  # DoubleConversion / glog / RCT-Folly are also provided by use_react_native! in 0.76.
  target 'sylkTests' do
    inherit! :search_paths
    # Pods for testing


  end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Apple Silicon Macs run the iOS Simulator as arm64. Excluding
      # arm64 here forces an x86_64-only build that LLDB can't attach
      # to natively (you'd see "specified architecture 'arm64-*-*' is
      # not compatible with 'x86_64-apple-ios*-simulator'"). Leave the
      # setting unset so pods build for whatever arch the host needs;
      # all currently-pinned pods ship arm64 simulator slices.
      config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
      # C++20 is required by the iOS 26 SDK headers (Apple clang 17+ has
      # deprecated several C++17-only constructs that RCT-Folly's
      # config.h still references). Stays compatible with RN 0.73's
      # RCT-Folly podspec.
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
      # Bumped from iOS 14 to iOS 15.1 for Xcode 26 / iOS 26 SDK
      # compliance (App Store Connect rejects builds linking to the
      # iOS 26 SDK with deployment targets older than what the SDK
      # supports). 15.1 is the practical floor for RN 0.73 + Xcode 26.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'

      # RCT-Folly defines required for C++20 compilation under the
      # iOS 26 SDK. FOLLY_MOBILE / FOLLY_USE_LIBCPP keep its config.h
      # off the unavailable POSIX paths; FOLLY_HAVE_CLOCK_GETTIME stops
      # it falling back to mach_absolute_time which Apple now warns on.
      existing_defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      existing_defs = [existing_defs] unless existing_defs.is_a?(Array)
      folly_defs = [
        'FOLLY_NO_CONFIG=1',
        'FOLLY_MOBILE=1',
        'FOLLY_USE_LIBCPP=1',
        'FOLLY_HAVE_CLOCK_GETTIME=1',
      ]
      folly_defs.each do |d|
        existing_defs << d unless existing_defs.include?(d)
      end
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing_defs

      # Apple clang 17 (Xcode 26) removed -Wno-shorten-64-to-32 from
      # its accepted flag set; some pods (Flipper, FBLazyVector) still
      # ship it in OTHER_CFLAGS and the build now errors out. Strip it.
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_key|
        flags = config.build_settings[flag_key]
        next unless flags
        flags = flags.is_a?(Array) ? flags : flags.split(' ')
        flags = flags.reject { |f| f == '-Wno-shorten-64-to-32' }
        config.build_settings[flag_key] = flags
      end

    end
  end

  # ---- RCT-Folly / Flipper-Folly CacheLocality fix --------------------------
  #
  # Xcode 26's libc++ no longer marks std::atomic<T> as trivial (its internal
  # layout changed), so std::is_trivial<GlobalState>::value is now false.
  # Folly's static_assert is overly strict — what it actually needs is for
  # the static-local GlobalState to have a trivial destructor (so safe
  # zero-initialization on first use is sound). Relax the assert to test
  # that property explicitly. Idempotent: bails if the relaxed form is
  # already in place. Runs every time `pod install` regenerates Pods/.
  Dir.glob('Pods/**/folly/concurrency/CacheLocality.{h,cpp}').each do |path|
    src = File.read(path)
    next if src.include?('std::is_trivially_destructible<GlobalState>::value')
    next unless src.include?('std::is_trivial<GlobalState>::value')
    patched = src.gsub(
      /static_assert\s*\(\s*std::is_trivial<GlobalState>::value\s*\|\|\s*kCpplibVer\s*,\s*"not trivial"\s*\)\s*;/m,
      'static_assert(' \
        'is_constexpr_default_constructible_v<GlobalState> && ' \
        'std::is_trivially_destructible<GlobalState>::value, ' \
        '"unsuitable for global state");'
    )
    if patched == src
      Pod::UI.warn "Folly CacheLocality patch: pattern not matched in #{path} — please verify by hand."
    else
      File.write(path, patched)
      Pod::UI.puts "Folly CacheLocality patch: relaxed static_assert in #{path}"
    end
  end
  # ---- fmt consteval fix (Xcode 26 / Apple clang 17+) ------------------------
  # fmt 11.0.2 (pulled by RCT-Folly) enables consteval for Apple clang >= 14, but
  # Xcode 26 clang rejects fmt's own FMT_STRING consteval calls with
  # "basic_format_string ... is not a constant expression" (fmtlib/fmt#4740). The
  # project must stay on C++20 (RCT-Folly / iOS 26 SDK), so the C++17 downgrade
  # isn't an option, and a -D define is overridden by base.h's own unconditional
  # #define. Force FMT_USE_CONSTEVAL 0 in base.h — what fmt already does for other
  # broken-consteval toolchains. Idempotent; re-applied each pod install. Remove
  # when fmt / Xcode fix the consteval interaction.
  Dir.glob('Pods/fmt/include/fmt/base.h').each do |path|
    src = File.read(path)
    next if src.include?('RN/Xcode26 fmt consteval workaround')
    anchor = "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
    if src.include?(anchor)
      patched = src.sub(anchor,
        "// RN/Xcode26 fmt consteval workaround: Apple clang 17+ rejects fmt's\n" \
        "// FMT_STRING consteval calls (fmtlib/fmt#4740). Force off.\n" \
        "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n" \
        "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval")
      File.write(path, patched)
      Pod::UI.puts "fmt consteval fix: forced FMT_USE_CONSTEVAL 0 in #{path}"
    else
      Pod::UI.warn "fmt consteval fix: anchor not found in #{path} — verify by hand."
    end
  end

  # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
  react_native_post_install(
    installer,
    config[:reactNativePath],
    :mac_catalyst_enabled => false
   )
    ## Fix for XCode 12.5
    #find_and_replace("../node_modules/react-native/React/CxxBridge/RCTCxxBridge.mm",
    #"_initializeModules:(NSArray<id<RCTBridgeModule>> *)modules", "_initializeModules:(NSArray<Class> *)modules")
    #find_and_replace("../node_modules/react-native/ReactCommon/turbomodule/core/platform/ios/RCTTurboModuleManager.mm",
    #    "RCTBridgeModuleNameForClass(module))", "RCTBridgeModuleNameForClass(Class(module)))")
end
end

