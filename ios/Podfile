ENV['SWIFT_VERSION'] = '5'

# iOS has no newArchEnabled flag like Android's gradle.properties. On RN 0.76,
# use_react_native! defaults RCT_NEW_ARCH_ENABLED to 1 when unset, which builds
# the pods for the New Architecture while the app still runs old arch — the
# mismatch breaks FastImage and other native view managers at runtime. Pin it
# off until the planned New-Arch flip (flip this + Android's newArchEnabled together).
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

