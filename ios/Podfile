# Generic `node_require` so we can resolve both react-native's and
# react-native-permissions' Podfile scripts through node (allows hoisting).
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
# react-native-permissions v5 replaced the per-permission `Permission-*` pods
# with a setup_permissions() helper that rewrites RNPermissions.podspec to
# compile only the handlers we list (called after prepare_react_native_project!
# below). Require its setup script here.
node_require('react-native-permissions/scripts/setup.rb')

# ---- Xcode 26 objectVersion 70 compatibility -------------------------------
# Xcode 26 re-stamps ios/sylk.xcodeproj to `objectVersion = 70` on every save,
# but the installed Xcodeproj gem (1.27.0, via the global CocoaPods 1.16.2)
# only maps object versions up to 77 and aborts pod install with:
#   [Xcodeproj] Unable to find compatibility version string for object version `70`.
# CocoaPods copies the user project's object version onto the generated Pods
# project, so it hits the same gap. Teach Xcodeproj the mapping here — this runs
# on every `pod install`, so it survives Xcode re-writing 70 (a one-off edit to
# the .pbxproj does not). Remove once a released xcodeproj gem maps 70 natively.
require 'xcodeproj'
unless Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.key?(70)
  _patched_obj_versions = Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.dup
  _patched_obj_versions[70] = 'Xcode 16.0'
  Xcodeproj::Constants.send(:remove_const, :COMPATIBILITY_VERSION_BY_OBJECT_VERSION)
  Xcodeproj::Constants.const_set(:COMPATIBILITY_VERSION_BY_OBJECT_VERSION, _patched_obj_versions.freeze)
end

platform :ios, 15.1
prepare_react_native_project!

# react-native-permissions v5 handler selection — replaces the old per-handler
# `pod 'Permission-*'` lines. setup_permissions() rewrites RNPermissions.podspec
# so ONLY these handlers are compiled into the (autolinked) RNPermissions pod.
# Keep this list in sync with the permissions the app actually check()/request()s
# and with the Info.plist usage descriptions. LocationAlways + LocationWhenInUse
# are both required so check()/request() can distinguish 'Always' from 'While
# Using' authorization (otherwise both LOCATION_ALWAYS and LOCATION_WHEN_IN_USE
# come back UNAVAILABLE and the upfront share-location probe can't tell whether
# background sharing will work).
setup_permissions([
  'Camera',
  'Microphone',
  'Contacts',
  'PhotoLibrary',
  'MediaLibrary',
  'LocationAlways',
  'LocationWhenInUse',
])

