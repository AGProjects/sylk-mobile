<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- react-native-webrtc iOS screen sharing: the app opens a UNIX-socket
	     server in this App Group's shared container; the Broadcast Upload
	     Extension connects to it and streams screen frames. Must match the
	     group in sylk.entitlements. -->
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.agprojects.sylk-ios</string>
	<!-- Bundle id of the Broadcast Upload Extension; react-native-webrtc's
	     ScreenCapturePickerView pre-selects it in the system picker. -->
	<key>RTCScreenSharingExtension</key>
	<string>com.agprojects.sylk-ios.SylkBroadcast</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Blink</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.agprojects.sylk-ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sylk</string>
				<string>com.agprojects.sylk</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.agprojects.sylk-ios</string>
			<key>CFBundleURLSchemes</key>
			<!-- Dial-out links from outside the app. iOS RESERVES tel: for the
			     built-in Phone app - a third-party CFBundleURLSchemes entry for
			     it is ignored and there is no "Open with" chooser, so the
			     Android tel: intent-filter has no counterpart here. The
			     supported route on iOS is INStartCallIntent, declared under
			     NSUserActivityTypes below. These three schemes are NOT reserved
			     and mirror the android:scheme list in AndroidManifest.xml:
			     sip:/sips: for SIP links on web pages and mail signatures,
			     callto: for the Skype-era spelling some CRM click-to-dial
			     widgets still emit. All three land in app.js
			     dialFromExternalUrl, which prefills the URI field rather than
			     auto-dialing. -->
			<array>
				<string>sip</string>
				<string>sips</string>
				<string>callto</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>FirebaseScreenReportingEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string></string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>message</string>
		<string>sip</string>
		<string>readdle-spark</string>
		<string>airmail</string>
		<string>ms-outlook</string>
		<string>googlegmail</string>
		<string>inbox-gmail</string>
		<string>ymail</string>
		<string>superhuman</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>Required for file sharing. No data is collected.</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera is used for video calls</string>
	<key>NSContactsUsageDescription</key>
	<string>Contacts permission is needed to call to phone numbers or email addresses found in addressbook. No data is collected.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is used to share your live location with contacts in a chat.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Location is used to keep sharing live location with a contact while Blink is in the background, until you stop the share or it expires.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Location is used to keep sharing your location with a contact while Blink is in the background, until you stop the share or it expires.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Blink uses local network access to set up audio and video calls with low latency.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone is used for audio calls</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Library is used to send old photos and videos. No data is collected.</string>
	<!-- Lets iOS offer Blink as a calling app: the "Call with..." entry on a
	     Contacts card, the app row in Recents, and Siri "call Alice with
	     Blink". iOS delivers the pick as an NSUserActivity carrying an
	     INStartCallIntent, which AppDelegate.m's
	     application:continueUserActivity: hands to RNCallKeep; that fires
	     didReceiveStartCallAction -> CallManager._startedCall ->
	     app.js startCallFromCallKeeper. Without this key iOS never sends the
	     activity and that whole chain is unreachable. INStartCallIntent is
	     iOS 13+; the Audio/Video pair is the pre-13 spelling, kept for older
	     devices. -->
	<key>NSUserActivityTypes</key>
	<array>
		<!-- INSendMessageIntent turns incoming message pushes into COMMUNICATION
		     notifications. The notification service extension donates an
		     INInteraction for the sender and calls contentByUpdatingWithProvider:,
		     and iOS then attributes the banner to a person rather than to an app.
		     That attribution is what lets a Focus's per PERSON allow list apply
		     (Settings, Focus, People), the same route WhatsApp uses: an allowed
		     contact breaks through without Blink itself being on the Apps allow
		     list. It also gives the banner the sender's contact photo. -->
		<string>INSendMessageIntent</string>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
		<string>INStartVideoCallIntent</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>MaterialDesignIcons.ttf</string>
		<string>FontAwesome.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>voip</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

        <key>com.apple.security.application-groups</key>
        <array>
            <string>group.com.agprojects.sylk-ios</string>
        </array>
</dict>
</plist>
