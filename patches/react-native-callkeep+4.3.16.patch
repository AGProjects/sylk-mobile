+    /**
+     * Build a properly-schemed URI for an address handed to Telecom. (patched)
+     *
+     * Every destination this app dials is a SIP address; a PSTN call is just a
+     * SIP address whose user part happens to be a phone number. This URI is
+     * what Telecom forwards to the in-call UI, to Bluetooth HFP and to Android
+     * Auto, and all of them key off the SCHEME -- so a bare string
+     * ("4444@sylk.link", which Uri.parse turns into a SCHEMELESS uri), or the
+     * wrong scheme (Uri.fromParts(SCHEME_TEL, ...) produced the nonsensical
+     * "tel:4444@sylk.link"), leaves the address unrenderable downstream.
+     *
+     *   already schemed (tel:/sip:/sips:) -> kept verbatim
+     *   contains '@'                      -> sip:user@domain
+     *   otherwise                         -> tel:<number>
+     *
+     * The two cases are already separated upstream: CallManager.callKitHandle
+     * strips the domain off a phone number, so numbers arrive bare
+     * ("+31641372960") while SIP addresses keep their '@'.
+     */
+    static Uri toTelecomUri(String address) {
+        if (address == null) {
+            return null;
+        }
+        String value = address.trim();
+        if (value.isEmpty()) {
+            return null;
+        }
+        String lower = value.toLowerCase();
+        if (lower.startsWith("tel:") || lower.startsWith("sip:") || lower.startsWith("sips:")) {
+            return Uri.parse(value);
+        }
+        // Uri.parse, NOT Uri.fromParts. fromParts percent-ENCODES the
+        // scheme-specific part, so "4444@sylk.link" becomes
+        // "sip:4444%40sylk.link". Telecom itself decodes that via
+        // getSchemeSpecificPart, but the ENCODED form is what anything that
+        // renders the address verbatim ends up showing. Uri.parse keeps the
+        // literal form. (patched)
+        if (value.indexOf('@') > -1) {
+            return Uri.parse(PhoneAccount.SCHEME_SIP + ":" + value);
+        }
+        return Uri.parse(PhoneAccount.SCHEME_TEL + ":" + value);
+    }
