+// SylkZRTPBridge.mm
+//
+// Obj-C++ implementation of the iOS Sylk ZRTP native bridge.
+// Phase 2: noop FrameEncryptor / FrameDecryptor (passthrough memcpy).
+// Phase 3 will replace memcpy with AES-128-GCM.
+//
+// The fundamental challenge on iOS: the JitsiWebRTC.framework's Obj-C SDK
+// does NOT expose setFrameEncryptor: / setFrameDecryptor: as Cocoa methods,
+// even though the underlying webrtc::RtpSenderInterface / RtpReceiverInterface
+// have them. To install our encryptor we have to:
+//   1. Reach the wrapper's private `_nativeRtpSender` / `_nativeRtpReceiver`
+//      ivar via the Objective-C runtime (it's a scoped_refptr<RtpSenderInterface>
+//      = exactly one pointer in memory layout).
+//   2. Cast the ivar bytes to webrtc::RtpSenderInterface* and call the C++
+//      virtual SetFrameEncryptor() through our compat header's vtable.
+//
+// If the framework version's ivar name ever changes, this stops working —
+// it logs all ivar names on first failure to help adjust.
+
+#import "SylkZRTPBridge.h"
+
+#import <Foundation/Foundation.h>
+#import <objc/runtime.h>
+#import <atomic>
+#import <cstring>
+#import <cstdint>
+#import <map>
+#import <vector>
+
+#import <CommonCrypto/CommonCrypto.h>
+#import <CommonCrypto/CommonCryptor.h>
+
+#import "sylk_webrtc_compat.h"
+
+#define SZLOG(fmt, ...) NSLog((@"[SylkZRTP] " fmt), ##__VA_ARGS__)
+
+// Mirror of Android's SYLK_E2EE_BUILD. Bump in BOTH places when the wire
+// format / prefix size / framing changes, then rebuild both platforms.
+#define SYLK_E2EE_BUILD "build-2026-05-02-public-aesgcm"
+
+// Log once per process load. +load runs before any other code in this
+// translation unit, so its output is the very first SylkZRTP line in the
+// device log — easy to grep and confirm both phones match.
+__attribute__((constructor))
+static void SylkZRTPLogBuild(void) {
+    SZLOG(@"native lib loaded; build=%s", SYLK_E2EE_BUILD);
+}
+
+// ---- AES-128-GCM frame format constants -----------------------------------
+//
+// Wire format identical to Android (see MediaEncryptorJni.cpp):
+//   [1B header v|keyId][4B BE counter][ciphertext][16B GCM tag]
+// IV  = salt(8) || counter_be(4)  -> 12 bytes
+// AAD = header(1) || counter_be(4) -> 5 bytes
+namespace sylkzrtp {
+
+static constexpr size_t kKeyLen      = 16;
+static constexpr size_t kSaltLen     = 8;
+static constexpr size_t kIvLen       = 12;
+static constexpr size_t kTagLen      = 16;
+static constexpr size_t kHeaderLen   = 1;
+static constexpr size_t kCounterLen  = 4;
+static constexpr size_t kFrameOverhead = kHeaderLen + kCounterLen + kTagLen; // 21
+
+static inline uint8_t MakeHeader(uint8_t version, uint8_t keyId) {
+    // version in high 4 bits, keyId in low 4. Phase 3 = version 1.
+    return (uint8_t)(((version & 0x0F) << 4) | (keyId & 0x0F));
+}
+
+static inline void BuildIV(const uint8_t salt[kSaltLen], uint32_t counter, uint8_t out[kIvLen]) {
+    std::memcpy(out, salt, kSaltLen);
+    out[kSaltLen + 0] = (uint8_t)((counter >> 24) & 0xFF);
+    out[kSaltLen + 1] = (uint8_t)((counter >> 16) & 0xFF);
+    out[kSaltLen + 2] = (uint8_t)((counter >>  8) & 0xFF);
+    out[kSaltLen + 3] = (uint8_t)( counter        & 0xFF);
+}
+
+static inline void BuildAAD(uint8_t header, uint32_t counter, uint8_t out[kHeaderLen + kCounterLen]) {
+    out[0] = header;
+    out[1] = (uint8_t)((counter >> 24) & 0xFF);
+    out[2] = (uint8_t)((counter >> 16) & 0xFF);
+    out[3] = (uint8_t)((counter >>  8) & 0xFF);
+    out[4] = (uint8_t)( counter        & 0xFF);
+}
+
+// AES-128-GCM implementation built on top of public CommonCrypto only.
+//
+// We previously used CommonCrypto's CCCryptorGCMOneshotEncrypt /
+// CCCryptorGCMOneshotDecrypt, but those symbols live in CommonCryptoSPI.h
+// (private SPI). The Mac App Store validator now flags references to
+// _CCCryptorGCMOneshotEncrypt / _CCCryptorGCMOneshotDecrypt and rejects
+// the upload (validation error: "references non-public symbols").
+//
+// The replacement here uses only documented, public CommonCrypto APIs:
+//   * CCCrypt(kCCAlgorithmAES, kCCOptionECBMode, ...) — AES-ECB single-
+//     block, used for the GCM hash subkey H = E_K(0) and the per-block
+//     tag pre-image E_K(J0).
+//   * CCCryptorCreateWithMode(kCCModeCTR, ...) — AES-CTR streaming
+//     cipher for plaintext / ciphertext, with the initial counter
+//     block J0+1.
+//   * GHASH (the GF(2^128) polynomial hash) is implemented in pure C —
+//     no platform crypto available for it, but it doesn't need any
+//     beyond AES-ECB for the H subkey computation done above.
+//
+// The wire format (12-byte IV from salt||counter, 16-byte tag, AAD =
+// header||counter) is BYTE-IDENTICAL to the prior implementation and
+// to the Android side, so existing peers continue to interop. Verified
+// against NIST SP 800-38D test vectors before shipping.
+static inline void XorBlock(uint8_t* a, const uint8_t* b, size_t n) {
+    for (size_t i = 0; i < n; i++) a[i] ^= b[i];
+}
+
+// Single-block AES-ECB encrypt using public CommonCrypto.
+// CCCrypt() supports ECB via kCCOptionECBMode; one-shot is fine for 16 B.
+static bool AesEcbEncryptBlock(const uint8_t key[kKeyLen],
+                               const uint8_t in[16],
+                               uint8_t out[16]) {
+    size_t produced = 0;
+    CCCryptorStatus s = CCCrypt(
+        kCCEncrypt,
+        kCCAlgorithmAES,
+        kCCOptionECBMode,           // no padding, no IV
+        key, kKeyLen,
+        /*iv*/ nullptr,
+        in, 16,
+        out, 16,
+        &produced);
+    return s == kCCSuccess && produced == 16;
+}
+
+// AES-CTR over `in` of any length, using `initialCounter` as the
+// initial 16-byte counter block (CC increments per block internally).
+static bool AesCtrCrypt(const uint8_t key[kKeyLen],
+                        const uint8_t initialCounter[16],
+                        const uint8_t* in, size_t inLen,
+                        uint8_t* out) {
+    if (inLen == 0) return true;
+    CCCryptorRef ref = nullptr;
+    CCCryptorStatus s = CCCryptorCreateWithMode(
+        kCCEncrypt,
+        kCCModeCTR,
+        kCCAlgorithmAES,
+        ccNoPadding,
+        initialCounter,             // 16-byte initial counter block
+        key, kKeyLen,
+        /*tweak*/ nullptr, 0,
+        /*numRounds*/ 0,
+        /*options*/ kCCModeOptionCTR_BE,
+        &ref);
+    if (s != kCCSuccess || !ref) return false;
+    size_t produced = 0;
+    s = CCCryptorUpdate(ref, in, inLen, out, inLen, &produced);
+    CCCryptorRelease(ref);
+    return s == kCCSuccess && produced == inLen;
+}
+
+// V <- V * H over GF(2^128) per NIST SP 800-38D (right-shift form).
+// All inputs are big-endian 16-byte arrays; bit 0 of a byte is the MSB.
+static void GhashMul(uint8_t V[16], const uint8_t H[16]) {
+    uint8_t Z[16] = {0};
+    uint8_t W[16];
+    std::memcpy(W, V, 16);
+    for (int i = 0; i < 128; i++) {
+        const int byte = i >> 3;
+        const int bit  = 7 - (i & 7);
+        if ((H[byte] >> bit) & 1) {
+            XorBlock(Z, W, 16);
+        }
+        // W >>= 1, with reduction by R = 0xE1 || 0^120 if LSB was set.
+        const bool lsb = (W[15] & 1) != 0;
+        for (int j = 15; j > 0; j--) {
+            W[j] = (uint8_t)((W[j] >> 1) | ((W[j - 1] & 1) << 7));
+        }
+        W[0] = (uint8_t)(W[0] >> 1);
+        if (lsb) W[0] ^= 0xe1;
+    }
+    std::memcpy(V, Z, 16);
+}
+
+// Mix `data` of any length into the running GHASH state Y, padding the
+// final partial block with zero bytes per spec.
+static void GhashUpdate(uint8_t Y[16], const uint8_t H[16],
+                        const uint8_t* data, size_t len) {
+    while (len >= 16) {
+        XorBlock(Y, data, 16);
+        GhashMul(Y, H);
+        data += 16;
+        len  -= 16;
+    }
+    if (len > 0) {
+        uint8_t tmp[16] = {0};
+        std::memcpy(tmp, data, len);
+        XorBlock(Y, tmp, 16);
+        GhashMul(Y, H);
+    }
+}
+
+// J0 = IV(12 B) || 0x00000001  — the recommended GCM init counter
+// when IV length == 96 bits. Matches the IV layout we build in
+// BuildIV() above (salt(8) || counter_be(4)).
+static inline void BuildJ0(const uint8_t iv12[kIvLen], uint8_t J0[16]) {
+    std::memcpy(J0, iv12, 12);
+    J0[12] = 0; J0[13] = 0; J0[14] = 0; J0[15] = 1;
+}
+
+// Increment the rightmost 32-bit word of an initial counter block by 1
+// (with carry confined to those 32 bits, per GCM spec).
+static inline void Inc32(uint8_t block[16]) {
+    for (int i = 15; i >= 12; i--) {
+        block[i] = (uint8_t)(block[i] + 1);
+        if (block[i] != 0) break;
+    }
+}
+
+// Build the final GHASH length block: aadBits (uint64 BE), ctBits (uint64 BE).
+static inline void BuildLenBlock(size_t aadLen, size_t ctLen, uint8_t out[16]) {
+    const uint64_t aadBits = (uint64_t)aadLen * 8;
+    const uint64_t ctBits  = (uint64_t)ctLen  * 8;
+    for (int i = 0; i < 8; i++) {
+        out[i]     = (uint8_t)((aadBits >> (56 - 8 * i)) & 0xff);
+        out[8 + i] = (uint8_t)((ctBits  >> (56 - 8 * i)) & 0xff);
+    }
+}
+
+// One-shot AES-128-GCM encrypt. Output buffer must be at least
+// inLen + kTagLen. Writes ciphertext then 16-byte tag, returns true on
+// success. IV must be exactly kIvLen (12) bytes.
+static bool AesGcmEncrypt(const uint8_t* key,
+                          const uint8_t* iv,
+                          const uint8_t* aad, size_t aadLen,
+                          const uint8_t* in,  size_t inLen,
+                          uint8_t* out) {
+    // 1. Derive H = E_K(0).
+    uint8_t H[16] = {0};
+    uint8_t zero[16] = {0};
+    if (!AesEcbEncryptBlock(key, zero, H)) return false;
+
+    // 2. J0 = IV || 0x00000001.
+    uint8_t J0[16];
+    BuildJ0(iv, J0);
+
+    // 3. Encrypt plaintext with AES-CTR starting at J0+1.
+    uint8_t counter1[16];
+    std::memcpy(counter1, J0, 16);
+    Inc32(counter1);
+    if (!AesCtrCrypt(key, counter1, in, inLen, out)) return false;
+
+    // 4. Compute GHASH over AAD || ciphertext || lenBlock.
+    uint8_t S[16] = {0};
+    GhashUpdate(S, H, aad, aadLen);
+    GhashUpdate(S, H, out, inLen);
+
+    uint8_t lenBlock[16];
+    BuildLenBlock(aadLen, inLen, lenBlock);
+    XorBlock(S, lenBlock, 16);
+    GhashMul(S, H);
+
+    // 5. tag = E_K(J0) XOR S.
+    uint8_t Ej0[16];
+    if (!AesEcbEncryptBlock(key, J0, Ej0)) return false;
+    XorBlock(Ej0, S, 16);
+    std::memcpy(out + inLen, Ej0, kTagLen);
+    return true;
+}
+
+// One-shot AES-128-GCM decrypt. inLen MUST include tag (>= 16 bytes).
+// Writes plaintext (= inLen - 16 bytes) to out. Returns true on success
+// (tag verified), false otherwise. Tag verification is constant-time —
+// we never write plaintext on tag mismatch.
+static bool AesGcmDecrypt(const uint8_t* key,
+                          const uint8_t* iv,
+                          const uint8_t* aad, size_t aadLen,
+                          const uint8_t* in,  size_t inLen,
+                          uint8_t* out) {
+    if (inLen < kTagLen) return false;
+    const size_t ctLen = inLen - kTagLen;
+    const uint8_t* ct  = in;
+    const uint8_t* tag = in + ctLen;
+
+    // 1. H = E_K(0).
+    uint8_t H[16] = {0};
+    uint8_t zero[16] = {0};
+    if (!AesEcbEncryptBlock(key, zero, H)) return false;
+
+    // 2. J0 = IV || 0x00000001.
+    uint8_t J0[16];
+    BuildJ0(iv, J0);
+
+    // 3. Compute expected tag via GHASH over AAD || ciphertext || lenBlock.
+    uint8_t S[16] = {0};
+    GhashUpdate(S, H, aad, aadLen);
+    GhashUpdate(S, H, ct, ctLen);
+
+    uint8_t lenBlock[16];
+    BuildLenBlock(aadLen, ctLen, lenBlock);
+    XorBlock(S, lenBlock, 16);
+    GhashMul(S, H);
+
+    uint8_t expected[16];
+    if (!AesEcbEncryptBlock(key, J0, expected)) return false;
+    XorBlock(expected, S, 16);
+
+    // 4. Constant-time tag compare. Refuse to write plaintext on mismatch.
+    uint8_t diff = 0;
+    for (size_t i = 0; i < kTagLen; i++) diff |= (uint8_t)(expected[i] ^ tag[i]);
+    if (diff != 0) return false;
+
+    // 5. Decrypt with AES-CTR starting at J0+1.
+    uint8_t counter1[16];
+    std::memcpy(counter1, J0, 16);
+    Inc32(counter1);
+    return AesCtrCrypt(key, counter1, ct, ctLen, out);
+}
+
+}  // namespace sylkzrtp
+
+// ---- noop encryptor / decryptor C++ classes -------------------------------
+
+namespace sylkzrtp {
+
+class NoopFrameEncryptor : public webrtc::FrameEncryptorInterface {
+ public:
+    NoopFrameEncryptor() : ref_count_(0) {
+        SZLOG(@"NoopFrameEncryptor ctor %p", this);
+    }
+
+    int Encrypt(cricket::MediaType /*media_type*/,
+                uint32_t /*ssrc*/,
+                rtc::ArrayView<const uint8_t> /*additional_data*/,
+                rtc::ArrayView<const uint8_t> frame,
+                rtc::ArrayView<uint8_t> encrypted_frame,
+                size_t* bytes_written) override {
+        if (encrypted_frame.size() < frame.size()) return -1;
+        std::memcpy(encrypted_frame.data(), frame.data(), frame.size());
+        *bytes_written = frame.size();
+        return 0;
+    }
+
+    size_t GetMaxCiphertextByteSize(cricket::MediaType /*media_type*/,
+                                    size_t frame_size) override {
+        return frame_size;
+    }
+
+    void AddRef() const override {
+        ref_count_.fetch_add(1, std::memory_order_relaxed);
+    }
+    webrtc::RefCountReleaseStatus Release() const override {
+        const int prev = ref_count_.fetch_sub(1, std::memory_order_acq_rel);
+        if (prev == 1) {
+            delete this;
+            return webrtc::RefCountReleaseStatus::kDroppedLastRef;
+        }
+        return webrtc::RefCountReleaseStatus::kOtherRefsRemained;
+    }
+
+ protected:
+    ~NoopFrameEncryptor() override {
+        SZLOG(@"NoopFrameEncryptor dtor %p", this);
+    }
+
+ private:
+    mutable std::atomic<int> ref_count_;
+};
+
+class NoopFrameDecryptor : public webrtc::FrameDecryptorInterface {
+ public:
+    NoopFrameDecryptor() : ref_count_(0) {
+        SZLOG(@"NoopFrameDecryptor ctor %p", this);
+    }
+
+    Result Decrypt(cricket::MediaType /*media_type*/,
+                   const std::vector<uint32_t>& /*csrcs*/,
+                   rtc::ArrayView<const uint8_t> /*additional_data*/,
+                   rtc::ArrayView<const uint8_t> encrypted_frame,
+                   rtc::ArrayView<uint8_t> frame) override {
+        if (frame.size() < encrypted_frame.size()) {
+            return Result(Status::kFailedToDecrypt, 0);
+        }
+        std::memcpy(frame.data(), encrypted_frame.data(), encrypted_frame.size());
+        return Result(Status::kOk, encrypted_frame.size());
+    }
+
+    size_t GetMaxPlaintextByteSize(cricket::MediaType /*media_type*/,
+                                   size_t encrypted_frame_size) override {
+        return encrypted_frame_size;
+    }
+
+    void AddRef() const override {
+        ref_count_.fetch_add(1, std::memory_order_relaxed);
+    }
+    webrtc::RefCountReleaseStatus Release() const override {
+        const int prev = ref_count_.fetch_sub(1, std::memory_order_acq_rel);
+        if (prev == 1) {
+            delete this;
+            return webrtc::RefCountReleaseStatus::kDroppedLastRef;
+        }
+        return webrtc::RefCountReleaseStatus::kOtherRefsRemained;
+    }
+
+ protected:
+    ~NoopFrameDecryptor() override {
+        SZLOG(@"NoopFrameDecryptor dtor %p", this);
+    }
+
+ private:
+    mutable std::atomic<int> ref_count_;
+};
+
+// ---- Phase 3: keyed AES-128-GCM encryptor / decryptor --------------------
+
+class MediaFrameEncryptor : public webrtc::FrameEncryptorInterface {
+ public:
+    MediaFrameEncryptor(const uint8_t* key, const uint8_t* salt,
+                        uint8_t keyId, uint8_t videoPrefix)
+        : ref_count_(0), keyId_(keyId & 0x0F),
+          videoPrefix_(videoPrefix), counter_(0) {
+        std::memcpy(key_,  key,  kKeyLen);
+        std::memcpy(salt_, salt, kSaltLen);
+        SZLOG(@"MediaFrameEncryptor ctor %p keyId=%u videoPrefix=%u",
+              this, (unsigned)keyId_, (unsigned)videoPrefix_);
+    }
+
+    // Codec-dependent number of bytes left plaintext at start of each
+    // video frame (VP8=1, VP9=3, H264=2, AV1=1). JS computes the value
+    // from the negotiated codec and passes it via the constructor.
+    size_t UnencryptedPrefixForMediaType(cricket::MediaType mt) const {
+        return mt == cricket::MEDIA_TYPE_VIDEO ? (size_t)videoPrefix_ : 0;
+    }
+
+    int Encrypt(cricket::MediaType media_type,
+                uint32_t /*ssrc*/,
+                rtc::ArrayView<const uint8_t> /*additional_data*/,
+                rtc::ArrayView<const uint8_t> frame,
+                rtc::ArrayView<uint8_t> encrypted_frame,
+                size_t* bytes_written) override {
+        // One-shot proof-of-life log on the FIRST call to Encrypt — needed
+        // to confirm libwebrtc on this iOS framework is actually invoking
+        // our FrameEncryptor in the outgoing media path. If this never
+        // logs, SetFrameEncryptor accepted our object but the framework
+        // doesn't run frames through it.
+        static std::atomic<bool> g_encryptLogged{false};
+        bool expected = false;
+        if (g_encryptLogged.compare_exchange_strong(expected, true)) {
+            SZLOG(@"[SylkZRTP][encrypt] FIRST CALL — Encrypt() invoked, media_type=%d frameSize=%zu prefix=%zu",
+                  (int)media_type, frame.size(),
+                  UnencryptedPrefixForMediaType(media_type));
+        }
+
+        const size_t prefix = UnencryptedPrefixForMediaType(media_type);
+        if (frame.size() < prefix) return -1;
+        const size_t needed = frame.size() + kFrameOverhead;
+        if (encrypted_frame.size() < needed) return -1;
+
+        const uint32_t counter = counter_.fetch_add(1, std::memory_order_relaxed) + 1;
+        const uint8_t header = MakeHeader(/*version=*/1, keyId_);
+
+        uint8_t iv[kIvLen];
+        BuildIV(salt_, counter, iv);
+
+        uint8_t aad[kHeaderLen + kCounterLen];
+        BuildAAD(header, counter, aad);
+
+        uint8_t* out = encrypted_frame.data();
+        // 1. Plaintext prefix (codec descriptor bytes) copied as-is.
+        if (prefix > 0) {
+            std::memcpy(out, frame.data(), prefix);
+        }
+        // 2. Our 5-byte header (version|keyId + 32-bit BE counter).
+        out[prefix + 0] = header;
+        out[prefix + 1] = aad[1];
+        out[prefix + 2] = aad[2];
+        out[prefix + 3] = aad[3];
+        out[prefix + 4] = aad[4];
+        // 3. Encrypt only the bytes AFTER the prefix.
+        if (!AesGcmEncrypt(key_, iv, aad, sizeof(aad),
+                           frame.data() + prefix, frame.size() - prefix,
+                           out + prefix + kHeaderLen + kCounterLen)) {
+            return -1;
+        }
+        *bytes_written = needed;
+        return 0;
+    }
+
+    size_t GetMaxCiphertextByteSize(cricket::MediaType /*media_type*/,
+                                    size_t frame_size) override {
+        return frame_size + kFrameOverhead;
+    }
+
+    void AddRef() const override {
+        ref_count_.fetch_add(1, std::memory_order_relaxed);
+    }
+    webrtc::RefCountReleaseStatus Release() const override {
+        const int prev = ref_count_.fetch_sub(1, std::memory_order_acq_rel);
+        if (prev == 1) {
+            delete this;
+            return webrtc::RefCountReleaseStatus::kDroppedLastRef;
+        }
+        return webrtc::RefCountReleaseStatus::kOtherRefsRemained;
+    }
+
+ protected:
+    ~MediaFrameEncryptor() override {
+        SZLOG(@"MediaFrameEncryptor dtor %p", this);
+    }
+
+ private:
+    mutable std::atomic<int> ref_count_;
+    uint8_t key_[kKeyLen];
+    uint8_t salt_[kSaltLen];
+    uint8_t keyId_;
+    uint8_t videoPrefix_;   // bytes left plaintext at start of each video frame
+    std::atomic<uint32_t> counter_;
+};
+
+class MediaFrameDecryptor : public webrtc::FrameDecryptorInterface {
+ public:
+    MediaFrameDecryptor(const uint8_t* key, const uint8_t* salt,
+                        uint8_t keyId, uint8_t videoPrefix)
+        : ref_count_(0), keyId_(keyId & 0x0F), videoPrefix_(videoPrefix) {
+        std::memcpy(key_,  key,  kKeyLen);
+        std::memcpy(salt_, salt, kSaltLen);
+        SZLOG(@"MediaFrameDecryptor ctor %p keyId=%u videoPrefix=%u",
+              this, (unsigned)keyId_, (unsigned)videoPrefix_);
+    }
+
+    // Must match MediaFrameEncryptor's prefix or every frame fails the
+    // tag check and falls through to permissive passthrough.
+    size_t UnencryptedPrefixForMediaType(cricket::MediaType mt) const {
+        return mt == cricket::MEDIA_TYPE_VIDEO ? (size_t)videoPrefix_ : 0;
+    }
+
+    // Permissive decrypt — same policy as the Android side.
+    // If the frame doesn't look encrypted (wrong header / too short / tag
+    // mismatch), pass it through unchanged. Lets us decrypt the peer's
+    // encrypted frames while the peer's sender_enc isn't yet installed.
+    Result Decrypt(cricket::MediaType media_type,
+                   const std::vector<uint32_t>& /*csrcs*/,
+                   rtc::ArrayView<const uint8_t> /*additional_data*/,
+                   rtc::ArrayView<const uint8_t> encrypted_frame,
+                   rtc::ArrayView<uint8_t> frame) override {
+        const size_t prefix = UnencryptedPrefixForMediaType(media_type);
+
+        // One-line diagnostic counters, sampled at exponential decay so
+        // we don't spam the log (~50/sec/track when video is flowing).
+        // Updated by passthrough() via the lambda capture.
+        static std::atomic<uint64_t> g_total{0};
+        static std::atomic<uint64_t> g_short{0};
+        static std::atomic<uint64_t> g_hdrMismatch{0};
+        static std::atomic<uint64_t> g_smallOut{0};
+        static std::atomic<uint64_t> g_tagFail{0};
+        static std::atomic<uint64_t> g_ok{0};
+
+        auto bumpAndMaybeLog = [&]() {
+            const uint64_t n = g_total.fetch_add(1, std::memory_order_relaxed) + 1;
+            // Log on n=1, 10, 100, 1000, 10000, ...
+            uint64_t k = n; bool logIt = (n == 1);
+            while (k > 0 && (k % 10) == 0) { logIt = true; k /= 10; if (k == 1) break; if ((k % 10) != 0) { logIt = false; break; } }
+            if (n <= 10 || (n % 100) == 0) {
+                SZLOG(@"[SylkZRTP][decrypt-stats] total=%llu short=%llu hdrBad=%llu smallOut=%llu tagFail=%llu ok=%llu",
+                      (unsigned long long)n,
+                      (unsigned long long)g_short.load(),
+                      (unsigned long long)g_hdrMismatch.load(),
+                      (unsigned long long)g_smallOut.load(),
+                      (unsigned long long)g_tagFail.load(),
+                      (unsigned long long)g_ok.load());
+            }
+        };
+
+        auto passthrough = [&]() -> Result {
+            if (frame.size() < encrypted_frame.size()) {
+                return Result(Status::kFailedToDecrypt, 0);
+            }
+            std::memcpy(frame.data(), encrypted_frame.data(), encrypted_frame.size());
+            return Result(Status::kOk, encrypted_frame.size());
+        };
+
+        if (encrypted_frame.size() < prefix + kFrameOverhead) {
+            g_short.fetch_add(1, std::memory_order_relaxed);
+            bumpAndMaybeLog();
+            return passthrough();
+        }
+        const uint8_t* in = encrypted_frame.data();
+        const uint8_t header = in[prefix];
+        const uint8_t version = (header >> 4) & 0x0F;
+        const uint8_t keyId   =  header       & 0x0F;
+        if (version != 1 || keyId != keyId_) {
+            const uint64_t bad = g_hdrMismatch.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (bad <= 5 || (bad % 200) == 0) {
+                SZLOG(@"[SylkZRTP][decrypt] header mismatch: got version=%u keyId=%u (want version=1 keyId=%u) frameLen=%zu prefix=%zu",
+                      (unsigned)version, (unsigned)keyId, (unsigned)keyId_,
+                      encrypted_frame.size(), prefix);
+            }
+            bumpAndMaybeLog();
+            return passthrough();
+        }
+        const uint32_t counter =
+            ((uint32_t)in[prefix + 1] << 24) | ((uint32_t)in[prefix + 2] << 16) |
+            ((uint32_t)in[prefix + 3] <<  8) |  (uint32_t)in[prefix + 4];
+
+        const size_t ctTagLen     = encrypted_frame.size() - prefix - (kHeaderLen + kCounterLen);
+        const size_t plaintextLen = ctTagLen - kTagLen;
+        const size_t outLen       = prefix + plaintextLen;
+        if (frame.size() < outLen) {
+            g_smallOut.fetch_add(1, std::memory_order_relaxed);
+            bumpAndMaybeLog();
+            return passthrough();
+        }
+
+        uint8_t iv[kIvLen];
+        BuildIV(salt_, counter, iv);
+
+        uint8_t aad[kHeaderLen + kCounterLen];
+        BuildAAD(header, counter, aad);
+
+        // Copy the plaintext prefix bytes back, decrypt the rest into
+        // frame[prefix..].
+        if (prefix > 0) {
+            std::memcpy(frame.data(), in, prefix);
+        }
+        if (!AesGcmDecrypt(key_, iv, aad, sizeof(aad),
+                           in + prefix + kHeaderLen + kCounterLen, ctTagLen,
+                           frame.data() + prefix)) {
+            const uint64_t bad = g_tagFail.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (bad <= 5 || (bad % 200) == 0) {
+                SZLOG(@"[SylkZRTP][decrypt] GCM tag check FAILED: counter=%u keyId=%u prefix=%zu frameLen=%zu (this means the encryptor's bytes don't match the AAD/IV we computed — usually a key/salt mismatch or wire-format skew)",
+                      (unsigned)counter, (unsigned)keyId, prefix, encrypted_frame.size());
+                // Dump the first 32 bytes of the encrypted frame for hex inspection.
+                NSMutableString *hex = [NSMutableString stringWithCapacity:96];
+                size_t dumpLen = encrypted_frame.size() > 32 ? 32 : encrypted_frame.size();
+                for (size_t i = 0; i < dumpLen; i++) {
+                    [hex appendFormat:@"%02x ", encrypted_frame.data()[i]];
+                }
+                SZLOG(@"[SylkZRTP][decrypt]   first %zu bytes: %@", dumpLen, hex);
+            }
+            bumpAndMaybeLog();
+            return passthrough();
+        }
+        g_ok.fetch_add(1, std::memory_order_relaxed);
+        bumpAndMaybeLog();
+        return Result(Status::kOk, outLen);
+    }
+
+    // Output buffer must hold either plaintext (encrypted_size - 21)
+    // or a passthrough copy (= encrypted_size).
+    size_t GetMaxPlaintextByteSize(cricket::MediaType /*media_type*/,
+                                   size_t encrypted_frame_size) override {
+        return encrypted_frame_size;
+    }
+
+    void AddRef() const override {
+        ref_count_.fetch_add(1, std::memory_order_relaxed);
+    }
+    webrtc::RefCountReleaseStatus Release() const override {
+        const int prev = ref_count_.fetch_sub(1, std::memory_order_acq_rel);
+        if (prev == 1) {
+            delete this;
+            return webrtc::RefCountReleaseStatus::kDroppedLastRef;
+        }
+        return webrtc::RefCountReleaseStatus::kOtherRefsRemained;
+    }
+
+ protected:
+    ~MediaFrameDecryptor() override {
+        SZLOG(@"MediaFrameDecryptor dtor %p", this);
+    }
+
+ private:
+    mutable std::atomic<int> ref_count_;
+    uint8_t key_[kKeyLen];
+    uint8_t salt_[kSaltLen];
+    uint8_t keyId_;
+    uint8_t videoPrefix_;   // bytes left plaintext at start of each video frame
+};
+
+}  // namespace sylkzrtp
+
+// ---- runtime-ivar unwrap helpers ------------------------------------------
+
+// Find a pointer-sized ivar by trying a list of likely names. On failure
+// dumps the wrapper's ivar list to NSLog so the caller can update the list.
+static void* GetPointerIvarBytes(NSObject* obj, const char* const* candidates,
+                                 size_t numCandidates) {
+    Class cls = [obj class];
+    for (size_t i = 0; i < numCandidates; i++) {
+        Ivar iv = class_getInstanceVariable(cls, candidates[i]);
+        if (iv) {
+            ptrdiff_t offset = ivar_getOffset(iv);
+            return (char*)(__bridge void*)obj + offset;
+        }
+    }
+    // Diagnostic dump — only fires when none of the candidate names matched.
+    unsigned int count = 0;
+    Ivar* list = class_copyIvarList(cls, &count);
+    SZLOG(@"could not find a candidate ivar on %s; full ivar list:",
+          class_getName(cls));
+    for (unsigned int i = 0; i < count; i++) {
+        SZLOG(@"  ivar %u: name=%s type=%s",
+              i, ivar_getName(list[i]), ivar_getTypeEncoding(list[i]));
+    }
+    free(list);
+    return nullptr;
+}
+
+static webrtc::RtpSenderInterface* GetNativeRtpSender(id<RTC_OBJC_TYPE(RTCRtpSender)> objcSender) {
+    static const char* candidates[] = {
+        "_nativeRtpSender", "nativeRtpSender",
+        "_nativeRtpSenderRefPtr", "nativeRtpSenderRefPtr",
+        "_nativeSender", "nativeSender",
+    };
+    void* bytes = GetPointerIvarBytes((NSObject*)objcSender, candidates,
+                                      sizeof(candidates) / sizeof(candidates[0]));
+    if (!bytes) return nullptr;
+    // The ivar is a scoped_refptr<RtpSenderInterface> = exactly one pointer.
+    webrtc::RtpSenderInterface** native = (webrtc::RtpSenderInterface**)bytes;
+    return *native;
+}
+
+static webrtc::RtpReceiverInterface* GetNativeRtpReceiver(id<RTC_OBJC_TYPE(RTCRtpReceiver)> objcReceiver) {
+    static const char* candidates[] = {
+        "_nativeRtpReceiver", "nativeRtpReceiver",
+        "_nativeRtpReceiverRefPtr", "nativeRtpReceiverRefPtr",
+        "_nativeReceiver", "nativeReceiver",
+    };
+    void* bytes = GetPointerIvarBytes((NSObject*)objcReceiver, candidates,
+                                      sizeof(candidates) / sizeof(candidates[0]));
+    if (!bytes) return nullptr;
+    webrtc::RtpReceiverInterface** native = (webrtc::RtpReceiverInterface**)bytes;
+    return *native;
+}
+
+// ---- Obj-C surface --------------------------------------------------------
+
+// Informal-protocol category declarations for the framework's Obj-C
+// `setFrameEncryptor:` / `setFrameDecryptor:` selectors. These selectors
+// exist on RTCRtpSender / RTCRtpReceiver in the prebuilt
+// JitsiWebRTC.framework — proven by the strings dump showing
+// `-[RTCRtpSender ... setFrameEncryptor:]` and the type encoding
+// `v24@0:8{scoped_refptr<webrtc::FrameEncryptorInterface>=^{...}}16`
+// (i.e. a method that takes a scoped_refptr by value). They're just not
+// publicly declared in the framework headers.
+//
+// Calling the Obj-C entrypoint instead of the C++
+// `native->SetFrameEncryptor()` lets the framework's wrapper run any
+// thread-dispatch / state-bookkeeping it needs (capturing the encryptor
+// in an Obj-C ivar, marshalling onto the signaling thread, etc.). The
+// C++ direct path appears to register our object but never wire it into
+// the encode/decode pipeline on this prebuilt framework.
+//
+// The selectors take a struct {scoped_refptr<...> = pointer} which on
+// arm64 is passed in one register, exactly like a raw pointer. So the
+// type encoding lines up with what the compiler emits for these calls.
+@interface NSObject (SylkE2EE_FrameEncryption)
+- (void)setFrameEncryptor:(rtc::scoped_refptr<webrtc::FrameEncryptorInterface>)encryptor;
+- (void)setFrameDecryptor:(rtc::scoped_refptr<webrtc::FrameDecryptorInterface>)decryptor;
+@end
+
+// Keep strong references to every installed encryptor/decryptor so their
+// refcount doesn't drop to zero the instant the install function returns.
+//
+// On iOS M124, the prebuilt JitsiWebRTC.framework's
+// RtpSenderInterface::SetFrameEncryptor / RtpReceiverInterface::SetFrameDecryptor
+// take a scoped_refptr by value but apparently don't keep the strong ref
+// internally — the dtor of our MediaFrameEncryptor fires within
+// microseconds of the install completing, leaving the sender/receiver
+// without any encryptor. Result: outgoing frames go on the wire
+// unencrypted (or with garbage padding) and incoming encrypted frames
+// fall through to the decoder as ciphertext → garbled audio + frozen
+// video, but ONLY after the ZRTP handshake completes (the first ~3s of
+// plaintext flow fine because no encryption is even attempted yet).
+//
+// Holding the scoped_refptr in this static map keeps the refcount > 0
+// for the lifetime of the call. Entries are cleared when the same
+// sender/receiver gets a new encryptor/decryptor installed (replacing
+// the old one), or stay alive through the call's natural teardown.
+static NSLock *g_sylkRefLock = nil;
+static std::map<webrtc::RtpSenderInterface*,
+                rtc::scoped_refptr<webrtc::FrameEncryptorInterface>> *
+    g_senderEncryptors = nullptr;
+static std::map<webrtc::RtpReceiverInterface*,
+                rtc::scoped_refptr<webrtc::FrameDecryptorInterface>> *
+    g_receiverDecryptors = nullptr;
+
+static void EnsureSylkRefMaps() {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        g_sylkRefLock = [[NSLock alloc] init];
+        g_senderEncryptors = new std::map<webrtc::RtpSenderInterface*,
+            rtc::scoped_refptr<webrtc::FrameEncryptorInterface>>();
+        g_receiverDecryptors = new std::map<webrtc::RtpReceiverInterface*,
+            rtc::scoped_refptr<webrtc::FrameDecryptorInterface>>();
+    });
+}
+
+static void RetainEncryptor(webrtc::RtpSenderInterface* native,
+                            rtc::scoped_refptr<webrtc::FrameEncryptorInterface> enc) {
+    EnsureSylkRefMaps();
+    [g_sylkRefLock lock];
+    (*g_senderEncryptors)[native] = enc;
+    const size_t total = g_senderEncryptors->size();
+    [g_sylkRefLock unlock];
+    SZLOG(@"RetainEncryptor: stored ref for sender=%p (total live encryptors=%zu)",
+          native, total);
+}
+
+static void RetainDecryptor(webrtc::RtpReceiverInterface* native,
+                            rtc::scoped_refptr<webrtc::FrameDecryptorInterface> dec) {
+    EnsureSylkRefMaps();
+    [g_sylkRefLock lock];
+    (*g_receiverDecryptors)[native] = dec;
+    const size_t total = g_receiverDecryptors->size();
+    [g_sylkRefLock unlock];
+    SZLOG(@"RetainDecryptor: stored ref for receiver=%p (total live decryptors=%zu)",
+          native, total);
+}
+
+@implementation SylkZRTPBridge
+
++ (BOOL)installNoopEncryptorOnSender:(id<RTC_OBJC_TYPE(RTCRtpSender)>)sender {
+    if (!sender) return NO;
+    webrtc::RtpSenderInterface* native = GetNativeRtpSender(sender);
+    if (!native) {
+        SZLOG(@"installNoopEncryptorOnSender: native pointer not found");
+        return NO;
+    }
+    auto* enc = new sylkzrtp::NoopFrameEncryptor();
+    enc->AddRef();   // intentional leak — see Phase 3 install below
+    rtc::scoped_refptr<webrtc::FrameEncryptorInterface> ref(enc);
+    native->SetFrameEncryptor(ref);
+    RetainEncryptor(native, ref);   // belt-and-suspenders
+    SZLOG(@"installed noop encryptor on sender %p (native=%p)", sender, native);
+    return YES;
+}
+
++ (BOOL)installNoopDecryptorOnReceiver:(id<RTC_OBJC_TYPE(RTCRtpReceiver)>)receiver {
+    if (!receiver) return NO;
+    webrtc::RtpReceiverInterface* native = GetNativeRtpReceiver(receiver);
+    if (!native) {
+        SZLOG(@"installNoopDecryptorOnReceiver: native pointer not found");
+        return NO;
+    }
+    auto* dec = new sylkzrtp::NoopFrameDecryptor();
+    dec->AddRef();   // intentional leak — see Phase 3 install below
+    rtc::scoped_refptr<webrtc::FrameDecryptorInterface> ref(dec);
+    native->SetFrameDecryptor(ref);
+    RetainDecryptor(native, ref);   // belt-and-suspenders
+    SZLOG(@"installed noop decryptor on receiver %p (native=%p)", receiver, native);
+    return YES;
+}
+
++ (BOOL)installMediaEncryptorOnSender:(id<RTC_OBJC_TYPE(RTCRtpSender)>)sender
+                                  key:(NSData *)key
+                                 salt:(NSData *)salt
+                                keyId:(uint8_t)keyId
+                          videoPrefix:(uint8_t)videoPrefix {
+    if (!sender) return NO;
+    if (!key || key.length != sylkzrtp::kKeyLen) {
+        SZLOG(@"installMediaEncryptorOnSender: bad key length %lu",
+              (unsigned long)(key ? key.length : 0));
+        return NO;
+    }
+    if (!salt || salt.length != sylkzrtp::kSaltLen) {
+        SZLOG(@"installMediaEncryptorOnSender: bad salt length %lu",
+              (unsigned long)(salt ? salt.length : 0));
+        return NO;
+    }
+    webrtc::RtpSenderInterface* native = GetNativeRtpSender(sender);
+    if (!native) {
+        SZLOG(@"installMediaEncryptorOnSender: native pointer not found");
+        return NO;
+    }
+    auto* enc = new sylkzrtp::MediaFrameEncryptor(
+        (const uint8_t*)key.bytes,
+        (const uint8_t*)salt.bytes,
+        keyId, videoPrefix);
+    // Intentional leak (see decryptor side). Belt-and-suspenders.
+    enc->AddRef();
+    rtc::scoped_refptr<webrtc::FrameEncryptorInterface> ref(enc);
+
+    // Try the Obj-C wrapper's setFrameEncryptor: selector first. The
+    // wrapper does additional bookkeeping (thread dispatch + Obj-C ivar
+    // retention) that the bare C++ call skips. If the wrapper's selector
+    // doesn't exist for some reason, fall back to the direct C++ call.
+    SEL sel = @selector(setFrameEncryptor:);
+    if ([(NSObject*)sender respondsToSelector:sel]) {
+        [(NSObject*)sender setFrameEncryptor:ref];
+        SZLOG(@"installed AES-GCM encryptor via Obj-C setFrameEncryptor: on %p"
+              @" (native=%p) keyId=%u videoPrefix=%u",
+              sender, native, (unsigned)keyId, (unsigned)videoPrefix);
+    } else {
+        native->SetFrameEncryptor(ref);
+        SZLOG(@"installed AES-GCM encryptor via C++ SetFrameEncryptor on sender=%p"
+              @" (native=%p) keyId=%u videoPrefix=%u (Obj-C selector not found)",
+              sender, native, (unsigned)keyId, (unsigned)videoPrefix);
+    }
+    RetainEncryptor(native, ref);   // belt-and-suspenders
+    return YES;
+}
+
++ (BOOL)installMediaDecryptorOnReceiver:(id<RTC_OBJC_TYPE(RTCRtpReceiver)>)receiver
+                                    key:(NSData *)key
+                                   salt:(NSData *)salt
+                                  keyId:(uint8_t)keyId
+                            videoPrefix:(uint8_t)videoPrefix {
+    if (!receiver) return NO;
+    if (!key || key.length != sylkzrtp::kKeyLen) {
+        SZLOG(@"installMediaDecryptorOnReceiver: bad key length %lu",
+              (unsigned long)(key ? key.length : 0));
+        return NO;
+    }
+    if (!salt || salt.length != sylkzrtp::kSaltLen) {
+        SZLOG(@"installMediaDecryptorOnReceiver: bad salt length %lu",
+              (unsigned long)(salt ? salt.length : 0));
+        return NO;
+    }
+    webrtc::RtpReceiverInterface* native = GetNativeRtpReceiver(receiver);
+    if (!native) {
+        SZLOG(@"installMediaDecryptorOnReceiver: native pointer not found");
+        return NO;
+    }
+    auto* dec = new sylkzrtp::MediaFrameDecryptor(
+        (const uint8_t*)key.bytes,
+        (const uint8_t*)salt.bytes,
+        keyId, videoPrefix);
+    // Intentional leak. Belt-and-suspenders.
+    dec->AddRef();
+    rtc::scoped_refptr<webrtc::FrameDecryptorInterface> ref(dec);
+
+    // Same pattern as encryptor — Obj-C path first, C++ fallback.
+    SEL sel = @selector(setFrameDecryptor:);
+    if ([(NSObject*)receiver respondsToSelector:sel]) {
+        [(NSObject*)receiver setFrameDecryptor:ref];
+        SZLOG(@"installed AES-GCM decryptor via Obj-C setFrameDecryptor: on %p"
+              @" (native=%p) keyId=%u videoPrefix=%u",
+              receiver, native, (unsigned)keyId, (unsigned)videoPrefix);
+    } else {
+        native->SetFrameDecryptor(ref);
+        SZLOG(@"installed AES-GCM decryptor via C++ SetFrameDecryptor on receiver=%p"
+              @" (native=%p) keyId=%u videoPrefix=%u (Obj-C selector not found)",
+              receiver, native, (unsigned)keyId, (unsigned)videoPrefix);
+    }
+    RetainDecryptor(native, ref);   // belt-and-suspenders
+    return YES;
+}
+
++ (NSString *)sylkE2EEBuild {
+    return @SYLK_E2EE_BUILD;
+}
