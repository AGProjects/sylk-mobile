+// sylk_e2ee_build.h — SINGLE SOURCE OF TRUTH for the Sylk E2EE build tag.
+//
+// Included by both MediaEncryptorJni.cpp and sylk_e2ee.cpp; nativeGetBuild()
+// (in sylk_e2ee.cpp) reports it and app.js compares the report against its own
+// SYLK_E2EE_BUILD constant. Keep it here only — never reintroduce a second
+// copy in a .cpp (a drifted duplicate once made the app report an old build
+// while running new code).
+//
+// Current scheme: whole-frame AES-128-GCM for audio + VP8/VP9 video (the
+// fixed-prefix FrameEncryptor). H.264 is NOT end-to-end encrypted — see
+// future_patches/h264/ for the NAL-aware attempt and why it can't work with
+// the prebuilt libwebrtc. Bump on any wire-format change and update the
+// matching constant in app/app.js.
+
+#ifndef SYLK_E2EE_BUILD_H_
+#define SYLK_E2EE_BUILD_H_
+
+#define SYLK_E2EE_BUILD "build-2026-05-02-public-aesgcm"
+
+#endif  // SYLK_E2EE_BUILD_H_
