+        if (track == null) {
+            displayMediaPromise.reject(new RuntimeException("ScreenTrack is null."));
+        } else {
+            createStream(new MediaStreamTrack[] {track}, (streamId, tracksInfo) -> {
+                WritableMap data = Arguments.createMap();
